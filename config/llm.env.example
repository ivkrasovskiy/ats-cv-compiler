CV_LLM_MODE=api
CV_LLM_BASE_URL=http://127.0.0.1:1234
CV_LLM_MODEL=lmstudio-community/qwen3-8b-mlx
CV_LLM_TIMEOUT_SECONDS=300
CV_LLM_API_KEY=

# Agent chain (claude -p / Claude Code subscription, zero API tokens)
CV_AGENT_CHAIN_ENABLED=false
CV_CODEX_CMD=claude
CV_CODEX_ARGS=-p
CV_CODEX_PROMPT_MODE=stdin
CV_AGENT_CONTEXT_DIR=out/context
CV_AGENT_TIMEOUT_JOB_ANALYSIS=120
CV_AGENT_TIMEOUT_EXPERIENCE=600
CV_AGENT_TIMEOUT_SKILLS=120
CV_AGENT_TIMEOUT_BULLET_POLISH=180
CV_AGENT_TIMEOUT_SUMMARY=180
CV_AGENT_KEYWORD_COVERAGE_MIN=0.5
CV_AGENT_MAX_BULLET_CHARS=200
CV_AGENT_MAX_SUMMARY_CHARS=1500
