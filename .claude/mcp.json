{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser", "chrome",
        "--executable-path", "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser",
        "--headed",
        "--viewport-size", "1280,800"
      ]
    }
  }
}
